            locn:geometry "POLYGON ((13.0928 52.6688, 13.7501 52.6688, 13.7501 52.3454, 13.0928 52.3454, 13.0928 52.6688))"^^gsp:wktLiteral ] ;
    dct:title "Trinkwasserbrunnen" ;

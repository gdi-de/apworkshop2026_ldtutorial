    dct:accrualPeriodicity <http://publications.europa.eu/resource/authority/frequency/ANNUAL> ;
    dct:description "Der Datensatz zeigt die Standorte der Trinkwasserbrunnen in Berlin an. Mit den Trinkwasserbrunnen wird kostenlos und öffentlich zugänglich Trinkwasser bereitgestellt. Die Trinkwasserbrunnen sind von Mai bis Oktober in Betrieb und werden von den Berliner Wasserbetrieben mit Unterstützung des Landes Berlin aufgestellt und betrieben." ;
    dct:identifier "8aaca41b-d665-447a-93ec-b76e431852fc" ;
    dct:issued "2025-06-15"^^xsd:date ;
    dct:language <http://publications.europa.eu/resource/authority/language/DEU> ;
    dct:modified "2025-12-15T09:29:37.348945+00:00"^^xsd:dateTime ;

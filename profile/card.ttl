@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix ns1: <http://www.w3.org/ns/pim/space#> .
@prefix ns2: <http://www.w3.org/ns/solid/terms#> .

<docs//profile/card> a foaf:PersonalProfileDocument ;
    foaf:primaryTopic <https://gdi-de.github.io/apworkshop2026_ldtutorial//profile/card#> .

<https://gdi-de.github.io/apworkshop2026_ldtutorial//profile/card#> a foaf:Person ;
    ns1:storage <https://gdi-de.github.io/apworkshop2026_ldtutorial/gdide_dataset> ;
    ns2:privateTypeIndex <https://gdi-de.github.io/apworkshop2026_ldtutorial//settings/privateTypeIndex.ttl> ;
    ns2:publicTypeIndex <https://gdi-de.github.io/apworkshop2026_ldtutorial//settings/publicTypeIndex.ttl> .

